generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoAnimal {
  activo
  vendido
  muerto
  robado
}

enum TipoLote {
  ceba
  leche
  otros
}

enum MetodoPesaje {
  cinta
  bascula
  estimacion
}

enum TipoEventoSanitario {
  vacuna
  desparasitacion
  vitamina
  tratamiento
}

enum TipoNovedad {
  /// Pasó un día y ya -- "se arregló el bebedero", "se compró un bulto de
  /// sal". `fechaFin` no aplica.
  hecho
  /// Un régimen que dura -- "sal a voluntad desde el 5 de agosto" para un
  /// lote. `fecha` es su inicio; `fechaFin` nulo significa vigente.
  suministro
}

model Usuario {
  id       String @id @default(cuid())
  nombre   String
  correo   String @unique
  claveHash String
  creadoEn DateTime @default(now())
}

/// Supuestos editables con fecha de vigencia. Cambiar uno hoy nunca reescribe la historia.
model Parametro {
  id        String   @id @default(cuid())
  clave     String
  valor     String
  vigenteDesde DateTime @db.Date
  creadoPorId String?
  creadoEn  DateTime @default(now())

  @@index([clave, vigenteDesde])
}

/// La finca es única. `hectareasUtiles` vivió aquí como campo suelto hasta
/// que se detectó que, al no llevar vigencia, corregirlo (por ejemplo tras
/// desmontar un potrero) recalculaba hacia atrás toda la carga animal ya
/// cerrada -- exactamente lo que los seis parámetros de `Parametro` existen
/// para evitar. Ahora vive ahí, bajo la clave 'hectareas_utiles': ver
/// prisma/migrations/20260822230000_hectareas_utiles_a_parametro/migration.sql
/// para la migración que preserva el valor que ya tenía la finca real.
model Finca {
  id     String @id @default(cuid())
  nombre String
}

model Potrero {
  id            String  @id @default(cuid())
  nombre        String  @unique
  hectareas     Decimal @db.Decimal(6, 2)
  tipoPasto     String?
  capacidadKg   Int     @default(0)
  tieneAgua     Boolean @default(true)
  notas         String?
  anuladoEn     DateTime?
  motivoAnulacion String?

  lotes       Lote[]
  movimientosDesde Movimiento[] @relation("origen")
  movimientosHasta Movimiento[] @relation("destino")
  novedades   Novedad[]
}

model Lote {
  id              String   @id @default(cuid())
  nombre          String   @unique
  tipo            TipoLote
  fechaApertura   DateTime @db.Date
  fechaCierre     DateTime? @db.Date
  potreroActualId String?
  potreroActual   Potrero? @relation(fields: [potreroActualId], references: [id])
  fechaEntradaPotrero DateTime? @db.Date

  animales    Animal[]
  movimientos Movimiento[]
  eventos     EventoSanitario[]
  novedades   Novedad[]
}

model Animal {
  id                String       @id @default(cuid())
  /// Única entre los animales ACTIVOS, no en toda la historia -- dos ciclos de
  /// ceba al año reutilizan números de chapeta. La unicidad real la impone un
  /// índice único parcial escrito a mano (Prisma no declara índices parciales
  /// de forma nativa): ver
  /// prisma/migrations/20260822225112_chapeta_unica_por_activo/migration.sql.
  /// Este `@@index` de abajo es solo para las búsquedas por chapeta sin
  /// filtrar por estado; no reemplaza la restricción de unicidad.
  chapeta           String
  loteId            String
  lote              Lote         @relation(fields: [loteId], references: [id])
  sexo              String
  raza              String?
  cruce             String?
  proveedor         String?
  fechaEntrada      DateTime     @db.Date
  edadEntradaMeses  Int?
  condicionCorporal Int?
  pesoEntradaKg     Decimal      @db.Decimal(5, 1)
  /// Costo real de entrada en pesos colombianos, entero. Lo llena el plan 2.
  costoEntradaCop   Int          @default(0)
  estado            EstadoAnimal @default(activo)
  fechaSalida       DateTime?    @db.Date
  motivoSalida      String?
  /// Último peso real del animal, tomado al momento de la salida. Es un dato
  /// de engorde (no de plata): el precio, el comprador y las comisiones son
  /// del plan 2.
  pesoSalidaKg      Decimal?     @db.Decimal(5, 1)

  mediciones Medicion[]
  eventos    EventoSanitario[]

  @@index([loteId, estado])
  @@index([chapeta])
}

model Pesaje {
  id           String       @id @default(cuid())
  fecha        DateTime     @db.Date
  metodo       MetodoPesaje
  responsable  String
  notas        String?
  registradoPorId String
  creadoEn     DateTime     @default(now())
  anuladoEn    DateTime?
  motivoAnulacion String?
  anuladoPorId String?

  mediciones Medicion[]

  @@index([fecha])
}

model Medicion {
  id       String  @id @default(cuid())
  pesajeId String
  pesaje   Pesaje  @relation(fields: [pesajeId], references: [id], onDelete: Cascade)
  animalId String
  animal   Animal  @relation(fields: [animalId], references: [id])
  pesoKg   Decimal @db.Decimal(5, 1)

  @@unique([pesajeId, animalId])
  @@index([animalId])
}

model Movimiento {
  id              String   @id @default(cuid())
  loteId          String
  lote            Lote     @relation(fields: [loteId], references: [id])
  potreroOrigenId String?
  potreroOrigen   Potrero? @relation("origen", fields: [potreroOrigenId], references: [id])
  potreroDestinoId String
  potreroDestino  Potrero  @relation("destino", fields: [potreroDestinoId], references: [id])
  fecha           DateTime @db.Date
  registradoPorId String
  creadoEn        DateTime @default(now())

  @@index([loteId, fecha])
  @@index([potreroDestinoId, fecha])
}

model EventoSanitario {
  id            String   @id @default(cuid())
  tipo          TipoEventoSanitario
  fecha         DateTime @db.Date
  producto      String
  dosis         String?
  responsable   String
  proximaFecha  DateTime? @db.Date
  notas         String?
  animalId      String?
  animal        Animal?  @relation(fields: [animalId], references: [id])
  loteId        String?
  lote          Lote?    @relation(fields: [loteId], references: [id])
  registradoPorId String
  creadoEn      DateTime @default(now())

  @@index([proximaFecha])
}

/// El registro operativo de la finca (plan 1C): lo que pasa en el campo, sin
/// contabilidad -- eso es del plan 2, que además va a leer de aquí para
/// armar los gastos. Cubre las dos formas que el dueño eligió anotar, con el
/// mínimo detalle posible en cada una:
///
/// - `hecho`: pasó un día y ya ("se arregló el bebedero del Jobo"). `fecha`
///   es cuándo pasó; `fechaFin` no aplica. Puede referirse a un lote, a un
///   potrero, a ambos o a ninguno.
/// - `suministro`: un régimen que dura ("sal a voluntad desde el 5 de
///   agosto"). `fecha` es su inicio; `fechaFin` nulo significa que sigue
///   vigente -- es la respuesta a "¿qué está recibiendo este lote ahora
///   mismo?". Siempre apunta a un lote (no a un potrero: el suministro es
///   del ganado, no del potrero).
///
/// Nada se borra: se anula con motivo, igual que un Pesaje (`anuladoEn`,
/// `motivoAnulacion`, `anuladoPorId`). Cerrar un suministro (poner
/// `fechaFin`) es un evento normal de su ciclo de vida, no una anulación --
/// las dos cosas son independientes.
model Novedad {
  id              String      @id @default(cuid())
  tipo            TipoNovedad
  descripcion     String
  fecha           DateTime    @db.Date
  fechaFin        DateTime?   @db.Date
  loteId          String?
  lote            Lote?       @relation(fields: [loteId], references: [id])
  potreroId       String?
  potrero         Potrero?    @relation(fields: [potreroId], references: [id])
  registradoPorId String
  creadoEn        DateTime    @default(now())
  anuladoEn       DateTime?
  motivoAnulacion String?
  anuladoPorId    String?

  @@index([fecha])
  @@index([loteId, tipo, fechaFin])
}
