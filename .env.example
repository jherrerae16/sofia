DATABASE_URL="postgresql://jdh@localhost:5432/sofia"
AUTH_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
# Auth.js v5 no confía en el encabezado Host en producción salvo que se le
# diga explícitamente que lo haga (evita ataques de "Host header injection").
# Sin esto, `next start` deja el login en bucle sobre
# /api/auth/callback/credentials y nunca establece la sesión: la plataforma
# queda inaccesible desde el primer despliegue real. Necesario en todo
# entorno donde se corra `next start` (o el equivalente del proveedor de
# hosting) detrás de un proxy o dominio propio.
AUTH_TRUST_HOST=true
